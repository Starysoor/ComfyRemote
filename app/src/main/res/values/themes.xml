<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only: Compose draws everything. Background matches the
         Iris ink/paper so there is no flash before the first frame. -->
    <style name="Theme.Iris" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/iris_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
